# Copy this file to .env and fill in real values. Never commit .env itself.

# Django
SECRET_KEY=change-this-to-a-long-random-string
DEBUG=True
# To reach this app from other devices on your WiFi/LAN, add your PC's
# local IP here too (find it with `ipconfig`), e.g.:
# ALLOWED_HOSTS=127.0.0.1,localhost,192.168.1.15
ALLOWED_HOSTS=127.0.0.1,localhost

# MySQL database
DB_NAME=student_id_system
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_HOST=127.0.0.1
DB_PORT=3306

# Base URL encoded inside each student's QR code (no trailing slash).
# Change this to your real domain once deployed.
SITE_URL=http://127.0.0.1:8000

# WhatsApp notifications via a self-hosted WAHA server.
# Leave WAHA_BASE_URL blank to disable sending (messages get logged instead).
# See https://waha.devlike.pro/ for how to run a WAHA server (e.g. via Docker).
WAHA_BASE_URL=
WAHA_API_KEY=
WAHA_SESSION=default
WHATSAPP_COUNTRY_CODE=255
